# =============================================================================
# LaunderLens - Supabase Authentication & Google OAuth Configuration
# =============================================================================
# 1. Create a Supabase project at https://supabase.com
# 2. Go to Project Settings -> API to copy your Project URL and anon public key.
# 3. In the Supabase Dashboard, go to Authentication -> Providers -> Google:
#    - Enable Google provider.
#    - Add your Google OAuth Client ID and Secret (from Google Cloud Console).
#    - Ensure Authorized Redirect URL is set to:
#      https://<your-project-ref>.supabase.co/auth/v1/callback
# 4. Copy this file to .env:
#    cp .env.example .env
# =============================================================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
